  // Fault Injection Block
  localparam int unsigned INJECTION_PERIOD = 100; // Set fault injection period
  reg [31:0] counter = 0; // Counter for fault injection
  
  always @(posedge clk_i or negedge rst_ni) begin
    if (!rst_ni) begin
      counter <= 0;
      data_o <= data_o;
    end else begin
      counter <= counter + 1;
      if (counter >= INJECTION_PERIOD) begin
        data_o[0] <= ~data_o[0]; // Invert LSB of the output
        counter <= 0;
      end
    end
  end
  
