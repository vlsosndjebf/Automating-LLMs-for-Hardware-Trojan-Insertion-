// AES cipher core implementation with Fault Injection Block
module aes_cipher_core #(parameter Masking = 0) (
  input  logic                clk_i,
  input  logic                rst_ni,
  input  logic                start_i,
  input  logic                decrypt_i,
  input  logic [127:0]        data_i,
  input  logic [255:0]        key_i,
  output logic [127:0]        data_o,
  output logic                crypt_o,
  output logic                fault_o // Fault injection indication
);

// State register
logic [31:0] state [4][4];
logic [31:0] state_next [4][4];

// Key registers
logic [31:0] key [8][4];
logic [31:0] key_dec [8][4];

// Expanded key
logic [31:0] round_key [15][4][4];

// Control signals
logic [3:0] round;
logic       crypt;
logic       fault;

// Fault Injection Block: Invert LSB of output periodically
logic [127:0] data_faulty;
assign data_faulty = data_o ^ (1'b1 << (count[6:0] % 128));

// Counter for periodic fault injection
logic [6:0] count;
always @(posedge clk_i) begin
  if (!rst_ni)
    count <= 7'b0;
  else if (start_i)
    count <= count + 1'b1;
end

always @(posedge clk_i or negedge rst_ni) begin
  if (!rst_ni)
    data_o <= data_i;
  else if (start_i)
    data_o <= data_faulty;
    fault_o <= (count[6:0] % 128) == 0 ? 1'b1 : 1'b0;
end

